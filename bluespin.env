# Repo-level build configuration, loaded by the Justfile (and overridable via
# the environment, which is how CI injects the per-variant IMAGE_NAME).
IMAGE_NAME=bluespin
REPO_ORGANIZATION=LorbusChris
REPO_NAME=bluespin
IMAGE_DESC=Bluespin
IMAGE_KEYWORDS=bootc,ublue,universal-blue,bluefin,dx,surface
IMAGE_LOGO_URL=https://avatars.githubusercontent.com/LorbusChris
# Every platform (bluespin, bluespin-dx, bluespin-surface) is built per Fedora
# branch; the branch is the image tag, and `latest` is an alias for the default
# branch. Each branch names its base here, passed to the Containerfile as
# BASE_IMAGE by `just build <platform> <branch>`. Renovate reads every *_IMAGE=
# line in this file (regex manager in .github/renovate.json5): it bumps the
# tool images' digests and leaves the Fedora bases alone, see below.
DEFAULT_FEDORA_BRANCH=44
# The channel aliases follow Fedora's lifecycle: `latest` points at the
# default (stable) branch above, `next` at the branched pre-release, and
# `rolling` always at rawhide (no variable: that pairing never moves).
# When stable switches to 45, bump DEFAULT and NEXT together.
NEXT_FEDORA_BRANCH=45
# Every branch builds on Fedora's own Silverblue. 44 used to build on Bluefin,
# which is where this image's desktop defaults, codecs, kmod and branding came
# from; each of those is now built here instead, so the base has nothing left
# to contribute that we do not decide ourselves. The bases are floating tags
# on purpose: quay expires each build's digest after four weeks, so a pinned
# base is a build failure waiting for its bump -- in September 2026 a stalled
# Renovate left every leg red for twelve days. `just build` resolves the tag
# once per build, builds from that digest and records it in the image's
# org.opencontainers.image.base.* labels; Renovate is told not to pin it.
FEDORA_44_BASE_IMAGE=quay.io/fedora-ostree-desktops/silverblue:44
FEDORA_45_BASE_IMAGE=quay.io/fedora-ostree-desktops/silverblue:45
FEDORA_RAWHIDE_BASE_IMAGE=quay.io/fedora-ostree-desktops/silverblue:rawhide
CHUNKAH_IMAGE=quay.io/coreos/chunkah:latest@sha256:71e593421c5de7dcc7c8c5c50e98d3bac572055a76f399f61a491d123c20a523
IMAGE_BUILDER_IMAGE=ghcr.io/osbuild/image-builder-cli:latest@sha256:1a84dc3f590a1c6439c9aacf2a0891ea6fef70f7b7011f481587c1a8816d5969
