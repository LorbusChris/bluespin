# Repo-level build configuration, loaded by the Justfile (and overridable via
# the environment, which is how CI injects the per-variant IMAGE_NAME).
IMAGE_NAME=bluespin
REPO_ORGANIZATION=LorbusChris
REPO_NAME=bluespin
IMAGE_DESC=Bluespin
IMAGE_KEYWORDS=bootc,ublue,universal-blue,bluefin,dx,surface
IMAGE_LOGO_URL=https://avatars.githubusercontent.com/LorbusChris
DEFAULT_TAG=latest
# Base images, passed to the Containerfile as BASE_IMAGE by `just build`. These
# are the only copies of the pins; Renovate tracks every *_IMAGE= line here
# (regex manager in .github/renovate.json5).
#
# BASE_IMAGE: bluefin, not bluefin-dx -- the developer layer is re-created for
# the dx variant only, in build_files/dx.sh, so the other images do not carry
# it.
BASE_IMAGE=ghcr.io/ublue-os/bluefin:latest@sha256:4c07bfdb3e50d706b7892485cd1324e1010ff7f6e977bcf0de347995d184aa0b
# RAWHIDE_BASE_IMAGE: Fedora's own rawhide desktop, for the experimental image.
# Universal Blue publishes nothing above F44, so there is no Bluefin to build
# on there. quay tags this with expires-after=4w and rebuilds it less often
# than the F44 images, so this digest goes stale faster than BASE_IMAGE.
RAWHIDE_BASE_IMAGE=quay.io/fedora-ostree-desktops/silverblue:rawhide@sha256:8ffc09536aa80f0abac8319b044ac1e2da22199c1276d759fdee092b13ca07c6
CHUNKAH_IMAGE=quay.io/coreos/chunkah:latest@sha256:ff8b8b466a942ec6000445d4001fc661e2fc5a952ad9ee29b4de9ab09d1d1708
