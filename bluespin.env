REPO_ORGANIZATION=LorbusChris
REPO_NAME=bluespin
IMAGE_DESC=Bluespin
IMAGE_KEYWORDS=bootc,ublue,universal-blue,bluefin,dx,surface
IMAGE_LOGO_URL=https://avatars.githubusercontent.com/LorbusChris
DEFAULT_TAG=latest
BIB_IMAGE=quay.io/centos-bootc/bootc-image-builder:latest@sha256:2b52843ea2bfda73b0a08d97e76b734393b1d3a804681b9fabb26723bd3a2f0b
