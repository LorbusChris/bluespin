# Repo-level build configuration, loaded by the Justfile (and overridable via
# the environment, which is how CI injects the per-variant IMAGE_NAME).
IMAGE_NAME=bluespin
REPO_ORGANIZATION=LorbusChris
REPO_NAME=bluespin
IMAGE_DESC=Bluespin
IMAGE_KEYWORDS=bootc,ublue,universal-blue,bluefin,dx,surface
IMAGE_LOGO_URL=https://avatars.githubusercontent.com/LorbusChris
# Every platform (bluespin, bluespin-dx, bluespin-surface) is built per Fedora
# branch; the branch is the image tag, and `latest` is an alias for the default
# branch. Each branch names its base here, passed to the Containerfile as
# BASE_IMAGE by `just build <platform> <branch>`. These are the only copies of
# the pins; Renovate tracks every *_IMAGE= line in this file (regex manager in
# .github/renovate.json5).
DEFAULT_FEDORA_BRANCH=44
# The channel aliases follow Fedora's lifecycle: `latest` points at the
# default (stable) branch above, `next` at the branched pre-release, and
# `rolling` always at rawhide (no variable: that pairing never moves).
# When stable switches to 45, bump DEFAULT and NEXT together.
NEXT_FEDORA_BRANCH=45
# Every branch builds on Fedora's own Silverblue. 44 used to build on Bluefin,
# which is where this image's desktop defaults, codecs, kmod and branding came
# from; each of those is now built here instead, so the base has nothing left
# to contribute that we do not decide ourselves. quay tags these with
# expires-after=4w and rebuilds them less often than the Bluefin images did,
# so a pin nobody bumps for four weeks stops resolving at all -- Renovate's
# digest bumps are what keep these alive.
FEDORA_44_BASE_IMAGE=quay.io/fedora-ostree-desktops/silverblue:44@sha256:cc9d802740fbb84e4b6eeb944763a4a94da8fc18ce5d46ed5266cc18a8bb7346
FEDORA_45_BASE_IMAGE=quay.io/fedora-ostree-desktops/silverblue:45@sha256:aa39a436f2cde208998e4373a33870df525f1b5630dfbb6040741de7f748e9ef
FEDORA_RAWHIDE_BASE_IMAGE=quay.io/fedora-ostree-desktops/silverblue:rawhide@sha256:f06628bc89af6a8ec9c49e4b31bc4bc0a41ee1817fb0df6cc8881e9d572657d4
CHUNKAH_IMAGE=quay.io/coreos/chunkah:latest@sha256:8b56578258d1d10d3e1c7b0f71a4d05317c5fde331c4f483576a1b60e65f0cea
IMAGE_BUILDER_IMAGE=ghcr.io/osbuild/image-builder-cli:latest@sha256:572972c40aca8fae7568cfc11f242c3062f01584a327352a11ccfbc03bf087d2
