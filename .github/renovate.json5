{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  rebaseWhen: 'never',
  // Vendored GNOME Shell extensions in extensions/. Renovate's submodule
  // manager is off by default; it follows each submodule's tracked branch
  // (see .gitmodules), so our forks get bumped as we push to them.
  'git-submodules': {
    enabled: true,
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^bluespin\\.env$/',
      ],
      matchStrings: [
        '[A-Z0-9_]+_IMAGE=(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      // A vendored extension is only safe to bump if it still declares the
      // shell we ship -- the build asserts exactly that, so let CI be the
      // gate rather than merging these unreviewed.
      description: 'Never automerge vendored extension bumps',
      matchManagers: [
        'git-submodules',
      ],
      automerge: false,
    },
    {
      automerge: true,
      matchUpdateTypes: [
        'pin',
        'pinDigest',
      ],
    },
    {
      enabled: false,
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'pin',
      ],
      matchDepTypes: [
        'container',
      ],
      matchFileNames: [
        '.github/workflows/**.yaml',
        '.github/workflows/**.yml',
      ],
    },
  ],
}
