# EXPERIMENTAL: bluespin's own additions on plain Fedora Silverblue rawhide,
# to test them against the next GNOME before it ships. See
# build_files/build_rawhide.sh for what this image deliberately does without.
ARG IMAGE_NAME="${IMAGE_NAME:-bluespin-rawhide}"

# Allow build scripts to be referenced without being copied into the final image
FROM scratch AS ctx
COPY /build_files /build_files
COPY /files /files
COPY /extensions /extensions
COPY /cosign.pub /cosign.pub

# Base Image: Fedora's own rawhide desktop. Universal Blue publishes nothing
# above F44, so there is no bluefin-dx equivalent to build on here.
# NOTE: quay tags this with expires-after=4w and rebuilds it less often than
# the F44 images, so this digest goes stale faster than the one in Containerfile.
FROM quay.io/fedora-ostree-desktops/silverblue:rawhide@sha256:8ffc09536aa80f0abac8319b044ac1e2da22199c1276d759fdee092b13ca07c6 AS base

FROM base

ARG IMAGE_NAME="${IMAGE_NAME:-bluespin-rawhide}"

RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/build_files/build_rawhide.sh

RUN bootc container lint
