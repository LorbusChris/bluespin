# Nothing in stock GNOME registers a handler for trash:///. Upstream Nautilus
# declares only inode/directory and archive types, and neither gnome-session's
# gnome-mimeapps.list nor shared-mime-info's mimeapps.list mention trash, so
# opening trash:/// through xdg-open or gio open reports that no program
# handles it. This reproduces on plain Silverblue.
#
# This file sits above /etc/xdg/mimeapps.list in the XDG precedence order, and
# lookups fall through per mimetype, so listing one key here leaves the Bluefin
# base's associations (pdf, flatpakref, appimage) untouched. It is read only
# when XDG_CURRENT_DESKTOP contains GNOME, which is always true for this image.
[Default Applications]
x-scheme-handler/trash=org.gnome.Nautilus.desktop
