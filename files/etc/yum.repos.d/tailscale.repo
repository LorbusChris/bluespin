# Tailscale's vendor repo, vendored verbatim from
# https://pkgs.tailscale.com/stable/fedora/tailscale.repo except for
# enabled=0: same hygiene as RPMFusion and the COPRs -- no external repo is
# live in the shipped image; the build enables it for one transaction. The
# fedora path is release-agnostic, so one file serves every branch.
[tailscale-stable]
name=Tailscale stable
baseurl=https://pkgs.tailscale.com/stable/fedora/$basearch
enabled=0
type=rpm
repo_gpgcheck=1
gpgcheck=1
gpgkey=https://pkgs.tailscale.com/stable/fedora/repo.gpg
