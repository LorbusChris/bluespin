[Desktop Entry]
Type=Application
# Name and Comment are the msgids of GTK's own places-sidebar Trash entry;
# their translations are appended at build time from the gtk40 catalogs
# (see build.sh). Keep them verbatim.
Name=Trash
Comment=Open the trash
# A separate Nautilus window on the trash:/// location. Deliberately no
# StartupWMClass: with one set to org.gnome.Nautilus, the shell would match
# every Files window to this entry instead of org.gnome.Nautilus.desktop.
Exec=nautilus --new-window trash:///
Icon=user-trash
Terminal=false
StartupNotify=true
Categories=GNOME;GTK;Utility;
Keywords=trash;bin;wastebasket;recycle;deleted;files;restore;
