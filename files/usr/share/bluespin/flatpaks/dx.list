# The dx catalog: developer GUI tools -- what used to be preinstalled on
# bluespin-dx, plus the developer/design half of the old full-desktop
# catalog. Opt-in per-user, on any platform:
#   ujust install-flatpaks dx
# installs them, `ujust remove-flatpaks dx` takes them away.
# Validated against Flathub by .github/workflows/validate-flatpaks.yml.
#
# One app id per line; blank lines and # comments are ignored.
# bluespin-arches: x86_64 aarch64
